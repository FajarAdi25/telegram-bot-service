APP_VERSION=1.3.0

# Host/container port
APP_HOST_PORT=3004
APP_PORT=3004

# Telegram
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_CHAT_ID=-1000000000000
TELEGRAM_TOPIC_NOMAD_ID=2
TELEGRAM_TOPIC_CONSUL_ID=3
TELEGRAM_TOPIC_MINIO_ID=4
TELEGRAM_TOPIC_SSL_ID=

# Monitoring Service is exposed on Windows host port 3001.
# From this container, use host.docker.internal.
MONITORING_SERVICE_BASE_URL=http://host.docker.internal:3001
MONITORING_AUTH_USERNAME=<monitoring-basic-auth-username>
MONITORING_AUTH_PASSWORD=<monitoring-basic-auth-password>

# Existing MySQL on Windows host
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<your-local-password>
MYSQL_DATABASE=monitoring_telegram_bot
MYSQL_CONNECTION_LIMIT=10
